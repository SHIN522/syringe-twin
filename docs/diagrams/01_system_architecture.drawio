<mxfile host="SyringeTwin"><diagram name="System architecture" id="01_system_architecture"><mxGraphModel dx="1600" dy="1060" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1060" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:20px;color:#1F3A1A&quot;&gt;1 · System architecture&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;ISA-95 layers of the SyringeTwin digital twin. Only the twin owns simulated time; in PLC mode the PLC owns run, E-stop and F201 decisions.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#55625A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="56" as="geometry"/></mxCell><mxCell id="c3" value="Level 3 · MES / digital twin (Python, twin/)" style="swimlane;html=1;startSize=26;horizontal=1;rounded=1;arcSize=2;fontFamily=Segoe UI;fontSize=11;fontSize=12;fontStyle=1;fillColor=#E8F3E0;strokeColor=#46733D;fontColor=#1F3A1A;swimlaneFillColor=#FFFFFF;opacity=100;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1520" height="330" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Plant model&lt;/b&gt;&lt;br&gt;plant.py&lt;br&gt;motion · refills · wear · quality sampling" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#E8F3E0;strokeColor=#46733D;fontColor=#1F3A1A;" vertex="1" parent="c3"><mxGeometry x="30" y="45" width="260" height="85" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Sequence control&lt;/b&gt;&lt;br&gt;control.py&lt;br&gt;SFC steps · transfer interlocks · inspection" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#E8F3E0;strokeColor=#46733D;fontColor=#1F3A1A;" vertex="1" parent="c3"><mxGeometry x="320" y="45" width="270" height="85" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Fixed-step engine&lt;/b&g