<mxfile host="SyringeTwin"><diagram name="F201 cause and effect" id="04_f201_cause_effect"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:20px;color:#1F3A1A&quot;&gt;4 · F201 press overload: cause → effect → recovery&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;The required machine fault has a physical cause, an early warning, a local effect that propagates through material flow, and an audited recovery.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#55625A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="56" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Tool wear rises&lt;/b&gt;&lt;br&gt;+0.004 per press&lt;br&gt;(demo profile +0.010)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FFF4D6;strokeColor=#C08A1E;fontColor=#4A3A10;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="210" height="80" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Press force rises&lt;/b&gt;&lt;br&gt;F = 120 + 40·wear + N(0, 4) N" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FFF4D6;strokeColor=#C08A1E;fontColor=#4A3A10;" vertex="1" parent="1"><mxGeometry x="290" y="200" width="230" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;W202 early warning&lt;/b&gt; (amber)&lt;br&gt;5-press mean &amp;gt; 135 N or&lt;br&gt;trend predicts &amp;lt; N cycles to 160 N" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FFF4D6;strokeColor=#C08A1E;fontColor=#4A3A10;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="270" height="80" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Quality degrades&lt;/b&gt;&lt;br&gt;force outside 105–140 N → R2&lt;br&gt;damaged seal → leak &amp;gt; 5 Pa/s → R3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FDECE8;strokeColor=#B0563F;fontColor=#5A2215;" vertex="1" parent="1"><mxGeometry x="560" y="250" width="270" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Decision support&lt;/b&gt;&lt;br&gt;what-if: keep running vs change tool now&lt;br&gt;vs condition-based changes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FBF3DF;strokeColor=#9A7A2C;fontColor=#4A3A10;" vertex="1" parent="1"><mxGeometry x="880" y="120" width="280" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Force &amp;gt; 160 N&lt;/b&gt;&lt;br&gt;PLC P5-R1 sets F201&lt;br&gt;(or operator injection, tagged)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#E3EEF8;strokeColor=#3F6B93;fontColor=#1D3550;" vertex="1" parent="1"><mxGeometry x="290" y="390" width="230" height="80" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;S2 → FAULT&lt;/b&gt;&lt;br&gt;holds its pallet · outputs off&lt;br&gt;line keeps running (local fault)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FDECE8;strokeColor=#B0563F;fontColor=#5A2215;" vertex="1" parent="1"><mxGeometry x="560" y="390" width="270" height="80" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Upstream blocks&lt;/b&gt;&lt;br&gt;B2 fills → S1 BLOCKED → B1 → IN BLOCKED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FDECE8;strokeColor=#B0563F;fontColor=#5A2215;" vertex="1" parent="1"><mxGeometry x="880" y="340" width="300" height="70" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Downstream starves&lt;/b&gt;&lt;br&gt;S3, S4, OUT STARVED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FDECE8;strokeColor=#B0563F;fontColor=#5A2215;" vertex="1" parent="1"><mxGeometry x="880" y="440" width="300" height="70" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;KPIs react&lt;/b&gt;&lt;br&gt;throughput → 0 · availability ↓&lt;br&gt;rolling OEE ↓ · downtime clock runs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FDECE8;strokeColor=#B0563F;fontColor=#5A2215;" vertex="1" parent="1"><mxGeometry x="1220" y="390" width="260" height="80" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Alarm&lt;/b&gt;&lt;br&gt;red flashing lamp + horn (PLC P1-R4)&lt;br&gt;dashboard banner · alarm log" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FDECE8;strokeColor=#B0563F;fontColor=#5A2215;" vertex="1" parent="1"><mxGeometry x="1220" y="540" width="260" height="80" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Repair S2&lt;/b&gt;&lt;br&gt;MTTR 90 s · wear → 0&lt;br&gt;I_S2_TOOL_OK 0 → 1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FBF3DF;strokeColor=#9A7A2C;fontColor=#4A3A10;" vertex="1" parent="1"><mxGeometry x="1220" y="690" width="260" height="80" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Reset&lt;/b&gt;&lt;br&gt;PLC P8-R2 clears F201 only after repair&lt;br&gt;(early reset refused)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#E3EEF8;strokeColor=#3F6B93;fontColor=#1D3550;" vertex="1" parent="1"><mxGeometry x="880" y="690" width="300" height="80" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;S2 resumes at RETRACT&lt;/b&gt;&lt;br&gt;blocked/starved stations recover&lt;br&gt;throughput and rolling OEE recover" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#E8F3E0;strokeColor=#46733D;fontColor=#1F3A1A;" vertex="1" parent="1"><mxGeometry x="560" y="690" width="270" height="80" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Affected unit&lt;/b&gt;&lt;br&gt;keeps its force trace → rejected R2 at S4&lt;br&gt;full history in traceability" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#E8F3E0;strokeColor=#46733D;fontColor=#1F3A1A;" vertex="1" parent="1"><mxGeometry x="230" y="690" width="290" height="80" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="monitored" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="&gt; 140 N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="prompts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="&gt; 160 N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#B0563F;fontColor=#B0563F;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#B0563F;fontColor=#B0563F;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#B0563F;fontColor=#B0563F;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#B0563F;fontColor=#B0563F;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#B0563F;fontColor=#B0563F;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#B0563F;fontColor=#B0563F;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#B0563F;fontColor=#B0563F;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="operator" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="tool OK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="tool change resets wear (prevents the chain)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#9A7A2C;fontColor=#9A7A2C;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="c7" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Measured&lt;/b&gt; (validation matrix, demo profile, seed 7): W202 at ~409 sim-s, first R2 at ~453 sim-s, F201 at 869 sim-s (force 161.9 N); S1 BLOCKED 4.1 s and S3 STARVED 5.0 s after the trip; repair 90.0 s; affected part rejected R2 + R3." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#55625A;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1440" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>