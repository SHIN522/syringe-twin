<mxfile host="SyringeTwin"><diagram name="Data architecture" id="03_data_architecture"><mxGraphModel dx="1600" dy="760" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1600" pageHeight="760" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:20px;color:#1F3A1A&quot;&gt;3 · Data architecture&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Where every value comes from, where it goes, and in what format. One source of truth: the engine state.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#55625A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="56" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Engine state&lt;/b&gt; (model.State) · the only place time advances (fixed dt 0.1 s)&lt;br&gt;stations · buffers · pallets · parts · bins · alarms · commands · events · random generator per station" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#E8F3E0;strokeColor=#46733D;fontColor=#1F3A1A;" vertex="1" parent="1"><mxGeometry x="100" y="100" width="1420" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Live payload&lt;/b&gt; (0.5 s)&lt;br&gt;snapshot: states, counts,&lt;br&gt;bins, alarms&lt;br&gt;kpi: throughput, OEE, oee_win&lt;br&gt;meta: transfers, PLC status" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#E8F3E0;strokeColor=#46733D;fontColor=#1F3A1A;" vertex="1" parent="1"><mxGeometry x="100" y="250" width="220" height="120" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Dashboards&lt;/b&gt;&lt;br&gt;GET /api/live (2 Hz)&lt;br&gt;GET /api/parts/{serial}&lt;br&gt;/alarms · /events" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FBF3DF;strokeColor=#9A7A2C;fontColor=#4A3A10;" vertex="1" parent="1"><mxGeometry x="100" y="440" width="220" height="100" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Operator command&lt;/b&gt;&lt;br&gt;POST /api/commands&lt;br&gt;{cmd, args, user}&lt;br&gt;validated → applied →&lt;br&gt;audited" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FBF3DF;strokeColor=#9A7A2C;fontColor=#4A3A10;" vertex="1" parent="1"><mxGeometry x="340" y="250" width="220" height="120" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Historian · SQLite&lt;/b&gt;&lt;br&gt;one database per run&lt;br&gt;parts · part_events · alarms&lt;br&gt;commands · kpi_samples&lt;br&gt;state_log" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#F4F5F2;strokeColor=#7A887F;fontColor=#2A332D;" vertex="1" parent="1"><mxGeometry x="580" y="250" width="220" height="120" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Exports&lt;/b&gt;&lt;br&gt;part trace JSON · audit CSV&lt;br&gt;trends CSV · what-if JSON&lt;br&gt;validation matrix" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#F4F5F2;strokeColor=#7A887F;fontColor=#2A332D;" vertex="1" parent="1"><mxGeometry x="580" y="440" width="220" height="100" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;What-if&lt;/b&gt;&lt;br&gt;POST /api/whatif&lt;br&gt;deep copy under lock →&lt;br&gt;headless options →&lt;br&gt;result JSON" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FBF3DF;strokeColor=#9A7A2C;fontColor=#4A3A10;" vertex="1" parent="1"><mxGeometry x="820" y="250" width="220" height="120" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;OPC UA address space&lt;/b&gt;&lt;br&gt;ns=2;s=Line1.…&lt;br&gt;Stations.&amp;lt;St&amp;gt;.State&lt;br&gt;S2.Force · KPI.OEE&lt;br&gt;PLC.F201" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#E8F3E0;strokeColor=#46733D;fontColor=#1F3A1A;" vertex="1" parent="1"><mxGeometry x="1060" y="250" width="220" height="120" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;UaExpert&lt;/b&gt;&lt;br&gt;browse · subscribe · trend" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#F4F5F2;strokeColor=#7A887F;fontColor=#2A332D;" vertex="1" parent="1"><mxGeometry x="1060" y="440" width="220" height="100" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Modbus register map&lt;/b&gt;&lt;br&gt;twin → PLC %MW0–27&lt;br&gt;commands, E-stop OK, tool OK,&lt;br&gt;force×10, sequence numbers&lt;br&gt;PLC → twin %QX0.0–1.3 · %QW0–6" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#E3EEF8;strokeColor=#3F6B93;fontColor=#1D3550;" vertex="1" parent="1"><mxGeometry x="1300" y="250" width="220" height="120" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;OpenPLC Runtime&lt;/b&gt;&lt;br&gt;syringetwin.st · 20 ms scan" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#E3EEF8;strokeColor=#3F6B93;fontColor=#1D3550;" vertex="1" parent="1"><mxGeometry x="1300" y="440" width="220" height="100" as="geometry"/></mxCell><mxCell id="c14" value="engine.payload()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;exitX=0.0775;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="JSON / HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#9A7A2C;fontColor=#9A7A2C;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="execute or send to PLC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#9A7A2C;fontColor=#9A7A2C;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;exitX=0.5;exitY=0;entryX=0.2465;entryY=1;" edge="1" parent="1" source="c6" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="sample · 2 Hz" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;exitX=0.4155;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;dashed=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="deepcopy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#9A7A2C;fontColor=#9A7A2C;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;dashed=1;exitX=0.5845;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="publish · 0.5 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;exitX=0.7535;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="OPC UA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#46733D;fontColor=#46733D;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="plc_bridge.outputs()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#3F6B93;fontColor=#3F6B93;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;exitX=0.9225;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="write / read · 20 ms" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#3F6B93;fontColor=#3F6B93;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="run · F001 · F201 · F002 · verdict" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#3F6B93;fontColor=#3F6B93;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c13" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Tag dictionary&lt;/b&gt;: docs/plc/tag_dictionary.csv lists every signal once: twin field, OpenPLC address, Modbus register, GX Works3 device, OPC UA node and HMI object." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#55625A;" vertex="1" parent="1"><mxGeometry x="100" y="580" width="1420" height="30" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Rules&lt;/b&gt;: dashboards change state only through audited commands · what-if never touches the live state · undefined values are null and shown as “—” · every figure in the report comes from a saved run in docs/evidence." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#55625A;" vertex="1" parent="1"><mxGeometry x="100" y="615" width="1420" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>