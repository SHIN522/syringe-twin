<mxfile host="SyringeTwin"><diagram name="What-if decision loop" id="05_whatif_loop"><mxGraphModel dx="1500" dy="820" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1500" pageHeight="820" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:20px;color:#1F3A1A&quot;&gt;5 · What-if decision loop&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;The twin as a decision tool: test a decision on a copy before applying it to the line.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#55625A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="56" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;1 · Live twin&lt;/b&gt;&lt;br&gt;state at time t&lt;br&gt;(wear, force, WIP, alarms, RNG)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#E8F3E0;strokeColor=#46733D;fontColor=#1F3A1A;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="230" height="90" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;2 · Virtual copy&lt;/b&gt;&lt;br&gt;deepcopy under the engine lock&lt;br&gt;same random-number state" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#E8F3E0;strokeColor=#46733D;fontColor=#1F3A1A;" vertex="1" parent="1"><mxGeometry x="360" y="150" width="240" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;3 · Change one decision&lt;/b&gt;&lt;br&gt;A: keep running · tool change now ·&lt;br&gt;condition-based changes&lt;br&gt;B: one process step duration" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FBF3DF;strokeColor=#9A7A2C;fontColor=#4A3A10;" vertex="1" parent="1"><mxGeometry x="670" y="150" width="270" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;4 · Accelerated run&lt;/b&gt;&lt;br&gt;headless, no pacing: 1 sim-hour &amp;lt; 1 s&lt;br&gt;same automatic operator in every option&lt;br&gt;1 or 5 random seeds" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FBF3DF;strokeColor=#9A7A2C;fontColor=#4A3A10;" vertex="1" parent="1"><mxGeometry x="1010" y="150" width="290" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;5 · Compare KPIs&lt;/b&gt;&lt;br&gt;good units · throughput · rejects · Q · OEE&lt;br&gt;F201 count · downtime · lead time&lt;br&gt;design vs simulated bottleneck" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FBF3DF;strokeColor=#9A7A2C;fontColor=#4A3A10;" vertex="1" parent="1"><mxGeometry x="1010" y="360" width="290" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;6 · Recommend&lt;/b&gt;&lt;br&gt;best good output, only if ≥ 2 % gain&lt;br&gt;and better in ≥ 4 of 5 seeds;&lt;br&gt;otherwise “keep current” with the reason" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FBF3DF;strokeColor=#9A7A2C;fontColor=#4A3A10;" vertex="1" parent="1"><mxGeometry x="670" y="360" width="270" height="100" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;7 · Operator acts&lt;/b&gt;&lt;br&gt;e.g. Schedule tool change&lt;br&gt;command validated and audited" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#F4F5F2;strokeColor=#7A887F;fontColor=#2A332D;" vertex="1" parent="1"><mxGeometry x="360" y="360" width="240" height="100" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="applied to the live line" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c9" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Guarantee&lt;/b&gt;: the live twin is never modified by an analysis (tested: state fingerprint identical before and after)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#F4F5F2;strokeColor=#7A887F;fontColor=#2A332D;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="540" height="60" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Measured results&lt;/b&gt; (validation matrix, 20 sim-min of default production, 1 sim-hour horizon):&lt;br&gt;A · keep running 217 /h, change tool now 234 /h, &lt;b&gt;condition-based 337 /h&lt;/b&gt; · F201 2 → 0 · better in 5/5 seeds&lt;br&gt;B · S1 cure 3 → 2 s: +0 % (not the bottleneck) · S2 insert 3 → 0.5 s: +27.7 %, design bottleneck moves S2 → S1&lt;br&gt;Forecast check: “keep running” predicted the next live F201 at 229.2 sim-s; the live line tripped at 229.2 sim-s." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#55625A;" vertex="1" parent="1"><mxGeometry x="660" y="510" width="760" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>