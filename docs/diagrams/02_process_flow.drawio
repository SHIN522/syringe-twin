pace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FBF3DF;strokeColor=#9A7A2C;fontColor=#4A3A10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="190" height="70" as="geometry"/></mxCell><mxCell id="c29" value="consumed at step start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#9A7A2C;fontColor=#9A7A2C;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c28" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Material&lt;/b&gt;&lt;br&gt;Plunger 150 · Stopper 150&lt;br&gt;W210 / W211 &amp;lt; 15&lt;br&gt;auto-refill 30 s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FBF3DF;strokeColor=#9A7A2C;fontColor=#4A3A10;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="190" height="70" as="geometry"/></mxCell><mxCell id="c31" value="consumed at step start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#9A7A2C;fontColor=#9A7A2C;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c30" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Material&lt;/b&gt;&lt;br&gt;Cap bin 200&lt;br&gt;W310 &amp;lt; 20&lt;br&gt;auto-refill 30 s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FBF3DF;strokeColor=#9A7A2C;fontColor=#4A3A10;" vertex="1" parent="1"><mxGeometry x="910" y="110" width="190" height="70" as="geometry"/></mxCell><mxCell id="c33" value="consumed at step start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#9A7A2C;fontColor=#9A7A2C;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c32" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Measurements generated&lt;/b&gt;: S1 print offset (R1) · S2 press force = 120 + 40·wear + N(0,4) N (R2 outside 105–140 N; F201 above 160 N) · S3 cap OK / mark grade (R4, R5) · S4 leak rate, higher if force was out of window (R3 above 5 Pa/s)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#55625A;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1480" height="60" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;States&lt;/b&gt; (PackML-lite): STOPPED · STARVED · RUNNING · BLOCKED · FAULT · MAINT. A station is BLOCKED when its downstream buffer is full and STARVED when it has no pallet or no material." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#55625A;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1480" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>