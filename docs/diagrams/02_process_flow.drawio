<mxfile host="SyringeTwin"><diagram name="Process flow" id="02_process_flow"><mxGraphModel dx="1700" dy="760" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1700" pageHeight="760" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:20px;color:#1F3A1A&quot;&gt;2 · Factory and material flow&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Pallet loop with FIFO buffers (capacity 2). Times are simulation seconds; each station cycle = steps + one 2 s pallet transfer.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#55625A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="56" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;IN · Material input&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;PICK 1.5 · PLACE 1.0&lt;br&gt;WRITE_ID 0.5&lt;/span&gt;&lt;br&gt;3.0 + 2 = 5 s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FFFFFF;strokeColor=#9AA89C;fontColor=#2A332D;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="190" height="120" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;B1&lt;/b&gt;&lt;br&gt;FIFO · 2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#F4F5F2;strokeColor=#7A887F;fontColor=#2A332D;" vertex="1" parent="1"><mxGeometry x="250" y="295" width="60" height="50" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;S1 · Print + UV cure&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;CLAMP 0.5 · PRINT 2.0&lt;br&gt;CURE 3.0 · UNCLAMP 0.5&lt;/span&gt;&lt;br&gt;6.0 + 2 = 8 s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FFFFFF;strokeColor=#9AA89C;fontColor=#2A332D;" vertex="1" parent="1"><mxGeometry x="330" y="260" width="190" height="120" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;B2&lt;/b&gt;&lt;br&gt;FIFO · 2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#F4F5F2;strokeColor=#7A887F;fontColor=#2A332D;" vertex="1" parent="1"><mxGeometry x="540" y="295" width="60" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;S2 · Press + insert&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;PRESS 2.0 · INSERT 3.0&lt;br&gt;RETRACT 1.5 · RELEASE 0.5&lt;br&gt;HANDLING 1.0&lt;/span&gt;&lt;br&gt;8.0 + 2 = &lt;b&gt;10 s&lt;/b&gt;&lt;br&gt;&lt;b&gt;bottleneck · 360/h&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FFF4D6;strokeColor=#C08A1E;fontColor=#4A3A10;" vertex="1" parent="1"><mxGeometry x="620" y="260" width="190" height="120" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;B3&lt;/b&gt;&lt;br&gt;FIFO · 2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#F4F5F2;strokeColor=#7A887F;fontColor=#2A332D;" vertex="1" parent="1"><mxGeometry x="830" y="295" width="60" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;S3 · Cap + laser mark&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;CAP_PRESS 1.5 · LASER 2.5&lt;br&gt;VERIFY 1.0&lt;/span&gt;&lt;br&gt;5.0 + 2 = 7 s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FFFFFF;strokeColor=#9AA89C;fontColor=#2A332D;" vertex="1" parent="1"><mxGeometry x="910" y="260" width="190" height="120" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;B4&lt;/b&gt;&lt;br&gt;FIFO · 2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#F4F5F2;strokeColor=#7A887F;fontColor=#2A332D;" vertex="1" parent="1"><mxGeometry x="1120" y="295" width="60" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;S4 · Inspection&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;VISION 1.0 · LEAK 3.0&lt;br&gt;DECIDE 0.5 · DIVERT 0.5&lt;/span&gt;&lt;br&gt;5.0 + 2 = 7 s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#E8F3E0;strokeColor=#46733D;fontColor=#1F3A1A;" vertex="1" parent="1"><mxGeometry x="1200" y="260" width="190" height="120" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;OUT · Packing&lt;/b&gt;&lt;br&gt;UNLOAD 1.0&lt;br&gt;box of 10 good units" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#E8F3E0;strokeColor=#46733D;fontColor=#1F3A1A;" vertex="1" parent="1"><mxGeometry x="1450" y="190" width="190" height="90" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Reject bin&lt;/b&gt;&lt;br&gt;R1 print · R2 force · R3 leak&lt;br&gt;R4 cap · R5 mark grade D" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Segoe UI;fontSize=11;fillColor=#FDECE8;strokeColor=#B0563F;fontColor=#5A2215;" vertex="1" parent="1"><mxGeometry x="1450" y="350" width="190" height="90" as="geometry"/></mxCell><mxCell id="c14" value="2 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="2 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="2 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="2 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="2 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="2 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="2 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="2 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="PASS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontSize=10;strokeColor=#55625A;fontColor=#55625A;labelBackgroundColor=#FFFFFF;strokeWidth=1.4;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell>